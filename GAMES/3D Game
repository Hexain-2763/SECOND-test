<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon Rift Runner</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #07100e;
      color: #f4fff9;
      font-family: Arial, Helvetica, sans-serif;
    }

    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      cursor: crosshair;
    }

    #hud {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 5;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      align-items: start;
      padding: 14px clamp(14px, 3vw, 28px);
      pointer-events: none;
      background: linear-gradient(180deg, rgba(2, 12, 10, 0.82), rgba(2, 12, 10, 0));
    }

    .title {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      align-items: baseline;
      min-width: 0;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
    }

    h1 {
      font-size: clamp(20px, 3.8vw, 38px);
      line-height: 1;
      letter-spacing: 0;
    }

    .hint {
      color: #b6d6ca;
      font-size: clamp(12px, 1.8vw, 14px);
      line-height: 1.35;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(74px, auto));
      gap: 8px;
      justify-content: end;
      pointer-events: none;
    }

    .stat {
      min-height: 48px;
      padding: 8px 10px;
      border: 1px solid rgba(168, 255, 221, 0.28);
      background: rgba(4, 20, 16, 0.62);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(8px);
      border-radius: 8px;
    }

    .label {
      display: block;
      color: #91b9aa;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .value {
      display: block;
      margin-top: 3px;
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      white-space: nowrap;
    }

    #overlay {
      position: fixed;
      inset: 0;
      z-index: 8;
      display: grid;
      place-items: center;
      padding: 22px;
      background: radial-gradient(circle at 50% 42%, rgba(20, 90, 78, 0.16), rgba(2, 9, 8, 0.76));
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    #overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    .panel {
      width: min(520px, 100%);
      padding: 24px;
      border: 1px solid rgba(168, 255, 221, 0.3);
      border-radius: 8px;
      background: rgba(3, 17, 14, 0.82);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
      backdrop-filter: blur(12px);
      text-align: center;
    }

    .panel h2 {
      font-size: clamp(28px, 7vw, 52px);
      line-height: 1;
      letter-spacing: 0;
    }

    .panel p {
      margin: 14px auto 20px;
      max-width: 36ch;
      color: #c7e2d8;
      line-height: 1.45;
    }

    button {
      min-width: 154px;
      min-height: 44px;
      border: 0;
      border-radius: 8px;
      color: #03211a;
      background: #75ffd0;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(117, 255, 208, 0.22);
    }

    button:hover { filter: brightness(1.06); }

    #reticle {
      position: fixed;
      left: 50%;
      top: 50%;
      z-index: 4;
      width: 24px;
      height: 24px;
      transform: translate(-50%, -50%);
      border: 2px solid rgba(202, 255, 235, 0.7);
      border-radius: 50%;
      pointer-events: none;
    }

    #reticle::before,
    #reticle::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 34px;
      height: 2px;
      background: rgba(202, 255, 235, 0.55);
      transform: translate(-50%, -50%);
    }

    #reticle::after {
      width: 2px;
      height: 34px;
    }

    @media (max-width: 700px) {
      #hud {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        justify-content: stretch;
      }

      .stat {
        min-width: 0;
      }

      .value {
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <div id="hud">
    <div class="title">
      <h1>Neon Rift Runner</h1>
      <div class="hint">WASD or arrows to dodge. Aim with the mouse. Click or Space to fire. Collect green cores, avoid red mines.</div>
    </div>
    <div class="stats">
      <div class="stat"><span class="label">Score</span><span class="value" id="score">0</span></div>
      <div class="stat"><span class="label">Hull</span><span class="value" id="hull">100%</span></div>
      <div class="stat"><span class="label">Speed</span><span class="value" id="speed">1.0x</span></div>
    </div>
  </div>

  <div id="reticle" aria-hidden="true"></div>

  <div id="overlay" class="show">
    <div class="panel">
      <h2 id="overlay-title">Ready?</h2>
      <p id="overlay-copy">Pilot through the rift, blast mines before they reach you, and grab energy cores to push your score higher.</p>
      <button id="start-button">Start Run</button>
    </div>
  </div>

  <script type="module">
    import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js";

    const scoreEl = document.getElementById("score");
    const hullEl = document.getElementById("hull");
    const speedEl = document.getElementById("speed");
    const overlay = document.getElementById("overlay");
    const overlayTitle = document.getElementById("overlay-title");
    const overlayCopy = document.getElementById("overlay-copy");
    const startButton = document.getElementById("start-button");
    const reticle = document.getElementById("reticle");

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x07100e);
    scene.fog = new THREE.FogExp2(0x07100e, 0.035);

    const camera = new THREE.PerspectiveCamera(68, window.innerWidth / window.innerHeight, 0.1, 220);
    camera.position.set(0, 2.3, 9);

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const ambient = new THREE.HemisphereLight(0xb8fff0, 0x14352c, 1.35);
    scene.add(ambient);

    const key = new THREE.DirectionalLight(0xffffff, 2);
    key.position.set(4, 8, 6);
    key.castShadow = true;
    scene.add(key);

    const glow = new THREE.PointLight(0x4dffd0, 52, 50);
    glow.position.set(0, 2, 2);
    scene.add(glow);

    const ship = new THREE.Group();
    const shipBody = new THREE.Mesh(
      new THREE.ConeGeometry(0.48, 1.45, 4),
      new THREE.MeshStandardMaterial({ color: 0x72ffe0, roughness: 0.25, metalness: 0.45, emissive: 0x07352b })
    );
    shipBody.rotation.x = Math.PI / 2;
    shipBody.castShadow = true;
    ship.add(shipBody);

    const wingMat = new THREE.MeshStandardMaterial({ color: 0xf4fff9, roughness: 0.28, metalness: 0.25 });
    const leftWing = new THREE.Mesh(new THREE.BoxGeometry(1.05, 0.08, 0.36), wingMat);
    leftWing.position.set(-0.56, 0, 0.16);
    leftWing.rotation.z = -0.2;
    ship.add(leftWing);

    const rightWing = leftWing.clone();
    rightWing.position.x = 0.56;
    rightWing.rotation.z = 0.2;
    ship.add(rightWing);

    const engine = new THREE.PointLight(0x75ffd0, 8, 7);
    engine.position.set(0, 0, 0.72);
    ship.add(engine);
    scene.add(ship);

    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(64, 260, 24, 96),
      new THREE.MeshStandardMaterial({ color: 0x12332d, roughness: 0.78, metalness: 0.08 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -2.1;
    floor.position.z = -70;
    floor.receiveShadow = true;
    scene.add(floor);

    const grid = new THREE.GridHelper(70, 70, 0x75ffd0, 0x1a6655);
    grid.position.y = -2.06;
    grid.position.z = -52;
    scene.add(grid);

    const wallMaterial = new THREE.MeshStandardMaterial({ color: 0x17493f, roughness: 0.68, metalness: 0.1 });
    const walls = [];
    for (let i = 0; i < 28; i++) {
      const left = makeWall(-10.5, i);
      const right = makeWall(10.5, i);
      walls.push(left, right);
      scene.add(left, right);
    }

    const obstacles = [];
    const cores = [];
    const bolts = [];
    const particles = [];
    const lanes = [-4.8, -2.4, 0, 2.4, 4.8];
    const keys = new Set();
    const clock = new THREE.Clock();
    const raycaster = new THREE.Raycaster();
    const aimPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 52);
    const aimPoint = new THREE.Vector3(0, 0, -52);
    const mouse = new THREE.Vector2(0, 0);
    const boltForward = new THREE.Vector3(0, 1, 0);

    const mineGeometry = new THREE.IcosahedronGeometry(0.72, 1);
    const mineMaterial = new THREE.MeshStandardMaterial({
      color: 0xff445f,
      emissive: 0x4b0610,
      roughness: 0.34,
      metalness: 0.25
    });

    const coreGeometry = new THREE.OctahedronGeometry(0.52, 0);
    const coreMaterial = new THREE.MeshStandardMaterial({
      color: 0x87ff92,
      emissive: 0x1c9e4a,
      roughness: 0.22,
      metalness: 0.2
    });

    const boltGeometry = new THREE.CylinderGeometry(0.05, 0.05, 2.2, 10);
    const boltMaterial = new THREE.MeshBasicMaterial({ color: 0xcaffeb });

    let state = newGameState();

    function makeWall(x, index) {
      const h = 2.4 + Math.sin(index * 1.6) * 0.9 + Math.random() * 2.2;
      const wall = new THREE.Mesh(new THREE.BoxGeometry(2.2, h, 7.6), wallMaterial);
      wall.position.set(x + (Math.random() - 0.5) * 1.4, h / 2 - 2.1, -index * 8);
      wall.castShadow = true;
      wall.receiveShadow = true;
      return wall;
    }

    function newGameState() {
      return {
        running: false,
        gameOver: false,
        score: 0,
        hull: 100,
        speed: 18,
        spawnTimer: 0.55,
        coreTimer: 1.3,
        shotTimer: 0,
        distance: 0,
        targetX: 0,
        targetY: 0,
        velocityX: 0,
        velocityY: 0,
      };
    }

    function startGame() {
      clearObjects(obstacles);
      clearObjects(cores);
      clearObjects(bolts);
      clearObjects(particles);
      state = newGameState();
      state.running = true;
      ship.position.set(0, 0, 0);
      ship.rotation.set(0, 0, 0);
      overlay.classList.remove("show");
      updateHud();
    }

    function clearObjects(list) {
      while (list.length) {
        const obj = list.pop();
        scene.remove(obj);
      }
    }

    function spawnMine() {
      const mine = new THREE.Mesh(mineGeometry, mineMaterial);
      mine.position.set(lanes[Math.floor(Math.random() * lanes.length)], -0.55 + Math.random() * 2.7, -82);
      mine.rotation.set(Math.random() * 6, Math.random() * 6, Math.random() * 6);
      mine.userData.radius = 0.8;
      mine.castShadow = true;
      obstacles.push(mine);
      scene.add(mine);
    }

    function spawnCore() {
      const core = new THREE.Mesh(coreGeometry, coreMaterial);
      core.position.set(lanes[Math.floor(Math.random() * lanes.length)], -0.25 + Math.random() * 2.1, -82);
      core.userData.radius = 0.62;
      cores.push(core);
      scene.add(core);
    }

    function shoot() {
      if (!state.running || state.shotTimer > 0) return;
      const direction = getAimDirection();
      createBolt(direction, 0, 0.18);
      createBolt(direction, -0.34, -0.1);
      createBolt(direction, 0.34, -0.1);
      state.shotTimer = 0.12;
    }

    function createBolt(direction, sideOffset, verticalOffset) {
      const bolt = new THREE.Mesh(boltGeometry, boltMaterial);
      const right = new THREE.Vector3().crossVectors(direction, camera.up).normalize();
      const start = ship.position.clone()
        .addScaledVector(direction, 1.25)
        .addScaledVector(right, sideOffset);
      start.y += verticalOffset;
      bolt.position.copy(start);
      bolt.quaternion.setFromUnitVectors(boltForward, direction);
      bolt.userData.velocity = direction.clone().multiplyScalar(132);
      bolt.userData.radius = 0.64;
      bolts.push(bolt);
      scene.add(bolt);
    }

    function getAimDirection() {
      raycaster.setFromCamera(mouse, camera);
      raycaster.ray.intersectPlane(aimPlane, aimPoint);
      return aimPoint.clone().sub(ship.position).normalize();
    }

    function burst(position, color) {
      for (let i = 0; i < 10; i++) {
        const spark = new THREE.Mesh(
          new THREE.SphereGeometry(0.06 + Math.random() * 0.08, 8, 8),
          new THREE.MeshBasicMaterial({ color })
        );
        spark.position.copy(position);
        spark.userData.v = new THREE.Vector3(
          (Math.random() - 0.5) * 8,
          (Math.random() - 0.5) * 8,
          (Math.random() - 0.5) * 8
        );
        spark.userData.life = 0.45 + Math.random() * 0.35;
        particles.push(spark);
        scene.add(spark);
      }
    }

    function damage(amount) {
      state.hull = Math.max(0, state.hull - amount);
      camera.position.x += (Math.random() - 0.5) * 0.12;
      camera.position.y += (Math.random() - 0.5) * 0.08;
      if (state.hull <= 0) endGame();
    }

    function endGame() {
      state.running = false;
      state.gameOver = true;
      overlayTitle.textContent = "Run Ended";
      overlayCopy.textContent = `Final score: ${Math.floor(state.score)}. Hit Start Run to dive back into the rift.`;
      startButton.textContent = "Restart";
      overlay.classList.add("show");
    }

    function updateHud() {
      scoreEl.textContent = String(Math.floor(state.score));
      hullEl.textContent = `${Math.ceil(state.hull)}%`;
      speedEl.textContent = `${(state.speed / 18).toFixed(1)}x`;
    }

    function updateInput(dt) {
      const left = keys.has("ArrowLeft") || keys.has("KeyA");
      const right = keys.has("ArrowRight") || keys.has("KeyD");
      const up = keys.has("ArrowUp") || keys.has("KeyW");
      const down = keys.has("ArrowDown") || keys.has("KeyS");
      const inputX = Number(right) - Number(left);
      const inputY = Number(up) - Number(down);
      const accel = 112;
      const damping = Math.exp((inputX || inputY ? -16 : -34) * dt);

      state.velocityX = (state.velocityX + inputX * accel * dt) * damping;
      state.velocityY = (state.velocityY + inputY * accel * 0.78 * dt) * damping;
      state.velocityX = THREE.MathUtils.clamp(state.velocityX, -31.0, 31.0);
      state.velocityY = THREE.MathUtils.clamp(state.velocityY, -20.0, 20.0);

      state.targetX = THREE.MathUtils.clamp(state.targetX + state.velocityX * dt, -5.4, 5.4);
      state.targetY = THREE.MathUtils.clamp(state.targetY + state.velocityY * dt, -1.2, 3.1);
      if (Math.abs(state.targetX) >= 5.4) state.velocityX = 0;
      if (state.targetY <= -1.2 || state.targetY >= 3.1) state.velocityY = 0;

      ship.position.x = THREE.MathUtils.damp(ship.position.x, state.targetX, 36, dt);
      ship.position.y = THREE.MathUtils.damp(ship.position.y, state.targetY, 36, dt);
      ship.rotation.z = THREE.MathUtils.damp(ship.rotation.z, -state.velocityX * 0.012, 17, dt);
      ship.rotation.x = THREE.MathUtils.damp(ship.rotation.x, state.velocityY * 0.011, 17, dt);
    }

    function updateWorld(dt) {
      state.distance += state.speed * dt;
      state.speed = Math.min(38, state.speed + dt * 0.55);
      state.score += dt * state.speed * 1.8;
      glow.intensity = 42 + Math.sin(performance.now() * 0.004) * 8;

      for (const wall of walls) {
        wall.position.z += state.speed * dt;
        if (wall.position.z > 13) wall.position.z -= 224;
      }

      grid.position.z = ((grid.position.z + state.speed * dt) % 8) - 56;
      floor.position.z = -70 + Math.sin(state.distance * 0.035) * 2;
    }

    function updateSpawns(dt) {
      state.spawnTimer -= dt;
      state.coreTimer -= dt;
      if (state.spawnTimer <= 0) {
        spawnMine();
        state.spawnTimer = Math.max(0.32, 1.15 - state.speed * 0.018) + Math.random() * 0.35;
      }
      if (state.coreTimer <= 0) {
        spawnCore();
        state.coreTimer = 1.8 + Math.random() * 1.6;
      }
    }

    function updateBolts(dt) {
      for (let i = bolts.length - 1; i >= 0; i--) {
        const bolt = bolts[i];
        const previousPosition = bolt.position.clone();
        bolt.position.addScaledVector(bolt.userData.velocity, dt);
        if (bolt.position.z < -95 || Math.abs(bolt.position.x) > 20 || Math.abs(bolt.position.y) > 14) {
          scene.remove(bolt);
          bolts.splice(i, 1);
          continue;
        }
        for (let j = obstacles.length - 1; j >= 0; j--) {
          const mine = obstacles[j];
          if (distanceToSegment(mine.position, previousPosition, bolt.position) < mine.userData.radius + bolt.userData.radius) {
            burst(mine.position, 0xff6f7f);
            scene.remove(mine);
            scene.remove(bolt);
            obstacles.splice(j, 1);
            bolts.splice(i, 1);
            state.score += 75;
            break;
          }
        }
      }
    }

    function distanceToSegment(point, start, end) {
      const segment = end.clone().sub(start);
      const lengthSq = segment.lengthSq();
      if (lengthSq === 0) return point.distanceTo(start);
      const t = THREE.MathUtils.clamp(point.clone().sub(start).dot(segment) / lengthSq, 0, 1);
      return point.distanceTo(start.clone().addScaledVector(segment, t));
    }

    function updateHazards(dt) {
      for (let i = obstacles.length - 1; i >= 0; i--) {
        const mine = obstacles[i];
        mine.position.z += state.speed * dt;
        mine.rotation.x += dt * 1.8;
        mine.rotation.y += dt * 1.25;
        const hit = mine.position.distanceTo(ship.position) < mine.userData.radius + 0.68;
        if (hit) {
          burst(mine.position, 0xff445f);
          scene.remove(mine);
          obstacles.splice(i, 1);
          damage(22);
        } else if (mine.position.z > 12) {
          scene.remove(mine);
          obstacles.splice(i, 1);
        }
      }

      for (let i = cores.length - 1; i >= 0; i--) {
        const core = cores[i];
        core.position.z += state.speed * dt;
        core.rotation.y += dt * 3;
        core.rotation.x += dt * 1.5;
        const collected = core.position.distanceTo(ship.position) < core.userData.radius + 0.75;
        if (collected) {
          burst(core.position, 0x87ff92);
          scene.remove(core);
          cores.splice(i, 1);
          state.score += 150;
          state.hull = Math.min(100, state.hull + 5);
        } else if (core.position.z > 12) {
          scene.remove(core);
          cores.splice(i, 1);
        }
      }
    }

    function updateParticles(dt) {
      for (let i = particles.length - 1; i >= 0; i--) {
        const spark = particles[i];
        spark.userData.life -= dt;
        spark.position.addScaledVector(spark.userData.v, dt);
        spark.scale.multiplyScalar(0.97);
        if (spark.userData.life <= 0) {
          scene.remove(spark);
          particles.splice(i, 1);
        }
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.033);

      camera.position.x = THREE.MathUtils.damp(camera.position.x, ship.position.x * 0.12, 8, dt);
      camera.position.y = THREE.MathUtils.damp(camera.position.y, 2.3 + ship.position.y * 0.08, 8, dt);
      camera.lookAt(ship.position.x * 0.35, ship.position.y * 0.25, -10);

      if (state.shotTimer > 0) state.shotTimer -= dt;
      if (state.running) {
        updateInput(dt);
        updateWorld(dt);
        updateSpawns(dt);
        updateBolts(dt);
        updateHazards(dt);
        updateParticles(dt);
        updateHud();
      } else {
        ship.rotation.y += dt * 0.45;
        updateParticles(dt);
      }

      renderer.render(scene, camera);
    }

    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    });

    window.addEventListener("keydown", (event) => {
      if (event.code === "Space") {
        event.preventDefault();
        shoot();
      }
      keys.add(event.code);
    });

    window.addEventListener("keyup", (event) => {
      keys.delete(event.code);
    });

    function updateMouseAim(event) {
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
      reticle.style.left = `${event.clientX}px`;
      reticle.style.top = `${event.clientY}px`;
    }

    window.addEventListener("pointermove", updateMouseAim);

    window.addEventListener("pointerdown", (event) => {
      updateMouseAim(event);
      shoot();
    });

    startButton.addEventListener("click", startGame);
    updateHud();
    animate();
  </script>
</body>
</html>
